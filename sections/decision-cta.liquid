<section class="decision">
  <div class="decision__bg" aria-hidden="true">
    {%- liquid
      assign bg_video = section.settings.video_url
      if bg_video == blank and section.settings.use_bundled_video
        assign bg_video = 'decision-bg.mp4' | asset_url
      endif
      if section.settings.background != blank
        assign bg_poster = section.settings.background | image_url: width: 2000
      elsif section.settings.video_url == blank
        assign bg_poster = 'decision-bg-poster.webp' | asset_url
      else
        assign bg_poster = 'decision-bg.webp' | asset_url
      endif
    -%}
    {%- if bg_video != blank -%}
      <video autoplay muted loop playsinline preload="metadata" poster="{{ bg_poster }}"><source src="{{ bg_video }}" type="video/mp4"></video>
    {%- elsif section.settings.background != blank -%}
      {{ section.settings.background | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '900, 1400, 2000', sizes: '100vw' }}
    {%- else -%}
      <img src="{{ 'decision-bg.webp' | asset_url }}" alt="" width="2528" height="1086" loading="lazy" decoding="async">
    {%- endif -%}
  </div>
  <canvas class="decision__dust" data-dust aria-hidden="true"></canvas>
  <div class="decision__inner">
    <div class="decision__copy">
      <p class="eyebrow decision__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="decision__title">{{ section.settings.heading }} <span class="grad-text">{{ section.settings.heading_accent }}</span></h2>
      <p class="decision__sub">{{ section.settings.subheading }}</p>
      <p class="decision__text">{{ section.settings.text }}</p>
      <div class="cta-row decision__cta">
        {% render 'order-button', label: section.settings.primary_label, style: 'amber' %}
        {% render 'order-button', label: section.settings.secondary_label, style: 'outline' %}
      </div>
      <p class="decision__note">{{ section.settings.note }}</p>
    </div>
    <p class="assurance"><b>{{ section.settings.assure_1_bold }}</b> {{ section.settings.assure_1 }}<br><b>{{ section.settings.assure_2_bold }}</b>{{ section.settings.assure_2 }}</p>
    {% render 'book-stage', cover: section.settings.cover, back: section.settings.back, class: 'decision__stage' %}
  </div>
</section>
{% schema %}
{
  "name": "The decision (CTA)",
  "settings": [
    { "type": "image_picker", "id": "background", "label": "Background still (optional — bundled image used by default)" },
    { "type": "checkbox", "id": "use_bundled_video", "label": "Use the bundled background video", "default": true, "info": "Dark flowing grainy loop (decision-bg.mp4, 745 KB, 10 s). Untick to fall back to the still." },
    { "type": "url", "id": "video_url", "label": "Background video .mp4 (overrides the bundled video)" },
    { "type": "image_picker", "id": "cover", "label": "Book cover (optional — bundled artwork used by default)" },
    { "type": "image_picker", "id": "back", "label": "Back cover (optional — bundled artwork used by default)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE DECISION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your copy is" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (gradient)", "default": "waiting." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "It costs you the postage and about four hours of reading." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Worst case, you close it knowing for certain that ownership isn’t for you — and you stop spending energy on a “one day” that was never going to happen. Best case, you’re reading the instructions for the next ten years of your career." },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Send me my free copy" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Send me my free copy" },
    { "type": "text", "id": "note", "label": "Note", "default": "Free book · £4.95 postage · Any problems, hello@squatsuccess.co.uk" },
    { "type": "text", "id": "assure_1_bold", "label": "Assurance line 1 (bold)", "default": "5–7 days" },
    { "type": "text", "id": "assure_1", "label": "Assurance line 1", "default": "to your door." },
    { "type": "text", "id": "assure_2_bold", "label": "Assurance line 2 (bold)", "default": "No subscription" },
    { "type": "text", "id": "assure_2", "label": "Assurance line 2", "default": ", ever." }
  ],
  "presets": [{ "name": "The decision (CTA)" }]
}
{% endschema %}
