<section class="store"><div class="container">
  <h1 class="h-section" style="margin-bottom:24px">{{ 'general.search.search' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.search' | t }}" aria-label="Search">
    <button type="submit" class="btn btn--gold">{{ 'general.search.search' | t }}</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- if search.results_count == 0 -%}
        <p class="body" style="margin-top:32px">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- else -%}
        <div class="grid-cards" style="margin-top:32px">
          {%- for item in search.results -%}
            <a class="card" href="{{ item.url }}">
              {%- if item.featured_media -%}{{ item.featured_media | image_url: width: 600 | image_tag: loading: 'lazy' }}{%- endif -%}
              <div class="card__body"><p class="card__title">{{ item.title }}</p></div>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div></section>
{% schema %} { "name": "Search", "settings": [] } {% endschema %}
