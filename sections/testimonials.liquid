{%- comment -%} Figma "07-testimonials" → component "testimonial-carousel" (Story=Matt): cinematic single-story stage. {%- endcomment -%}
<section class="section--stage testimonials" id="stories">
  <div class="testimonials__head">
    <p class="eyebrow testimonials__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="testimonials__title">{{ section.settings.heading | newline_to_br }}</h2>
  </div>
  {%- if section.blocks.size > 0 -%}
  <div class="story" data-story>
    <div class="story__film" data-story-film>
      {%- for block in section.blocks -%}
        {%- if block.settings.poster != blank -%}
          {{ block.settings.poster | image_url: width: 1400 | image_tag: class: 'story__frame', alt: block.settings.name, loading: 'lazy', widths: '800, 1400', sizes: '(max-width: 1100px) 100vw, 920px', data-story-frame: forloop.index0 }}
        {%- else -%}
          <img class="story__frame{% if forloop.first %} is-active{% endif %}" data-story-frame="{{ forloop.index0 }}" src="{{ block.settings.fallback | asset_url }}" srcset="{{ block.settings.fallback | replace: '.webp', '-800.webp' | asset_url }} 800w, {{ block.settings.fallback | asset_url }} 1400w" sizes="(max-width: 1100px) 100vw, 920px" alt="{{ block.settings.name | escape }}" width="1400" height="{{ block.settings.fallback_height | default: 663 }}" {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %} decoding="async">
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="story__fade" aria-hidden="true"></div>
    <button type="button" class="story__stop" data-story-stop>✕ &nbsp;Close film</button>
    <div class="story__editorial" aria-live="polite">
      {%- for block in section.blocks -%}
        <div class="story__panel" data-story-panel="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
          <blockquote class="story__quote">{{ block.settings.quote }}</blockquote>
          <div class="story__who">
            <p class="story__name">{{ block.settings.name }}</p>
            <p class="story__role">{{ block.settings.role }}</p>
          </div>
          {%- if block.settings.video_url != blank -%}
          <a class="story__play" href="{{ block.settings.video_url }}" target="_blank" rel="noopener" data-story-play data-story-video="{{ block.settings.video_url | escape }}">
            {{ section.settings.play_label | replace: '[name]', block.settings.name }}
            <svg viewBox="0 0 28 28" aria-hidden="true"><circle cx="14" cy="14" r="14" fill="#C49C60"/><path d="M11 8.5L20 14l-9 5.5z" fill="#191510"/></svg>
          </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="story__select" role="tablist" aria-label="Choose a story">
      {%- for block in section.blocks -%}
        <button type="button" class="story__portrait" role="tab" data-story-select="{{ forloop.index0 }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
          <span>
            {%- if block.settings.poster != blank -%}
              {{ block.settings.poster | image_url: width: 224 | image_tag: alt: '', loading: 'lazy', widths: '224' }}
            {%- else -%}
              <img src="{{ block.settings.fallback | replace: '.webp', '-800.webp' | asset_url }}" alt="" width="800" height="{{ block.settings.fallback_height | default: 663 | times: 800 | divided_by: 1400 }}" loading="lazy" decoding="async">
            {%- endif -%}
          </span>
          <small>{{ block.settings.name }}</small>
        </button>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "REAL STORIES · REAL RESULTS" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "They were exactly\nwhere you are." },
    { "type": "text", "id": "play_label", "label": "Play button label ([name] is replaced)", "default": "Watch [name]’s story" }
  ],
  "max_blocks": 6,
  "blocks": [ { "type": "story", "name": "Story", "settings": [
    { "type": "text", "id": "name", "label": "Name", "default": "Dr Matt" },
    { "type": "text", "id": "role", "label": "Role / practice", "default": "SQUAT SUCCESS MEMBER" },
    { "type": "textarea", "id": "quote", "label": "Quote" },
    { "type": "url", "id": "video_url", "label": "Video (mp4, YouTube or Vimeo)" },
    { "type": "image_picker", "id": "poster", "label": "Film still (optional — bundled still used by default)" },
    { "type": "text", "id": "fallback", "label": "Bundled still", "info": "film-matt.webp, film-aisha.webp or film-laurie.webp", "default": "film-matt.webp" },
    { "type": "number", "id": "fallback_height", "label": "Bundled still height (px at 1400 wide)", "default": 663 }
  ]}],
  "presets": [{ "name": "Testimonials", "blocks": [
    { "type": "story", "settings": { "name": "Dr Matt", "role": "SQUAT SUCCESS MEMBER", "quote": "“He’s got such a good support network and I think that’s invaluable, really. … Bobby has been absolutely brilliant with helping me through the set up, how to start a practice.”", "video_url": "https://squatsuccess.co.uk/wp-content/uploads/2024/08/5th-video.mp4", "fallback": "film-matt.webp", "fallback_height": 663 } },
    { "type": "story", "settings": { "name": "Dr Aisha", "role": "SQUAT SUCCESS MEMBER", "quote": "“Squat Success has been a really valuable asset to me in regard to setting up my squat and helping me along the journey. If you’re thinking of setting up a dental squat practice, then this course is definitely for you.”", "video_url": "https://squatsuccess.co.uk/wp-content/uploads/2024/02/TESTIMONIAL-Aisha-1.mp4", "fallback": "film-aisha.webp", "fallback_height": 755 } },
    { "type": "story", "settings": { "name": "Dr Laurie", "role": "SQUAT SUCCESS MEMBER", "quote": "“Having a course like this, where you learn a bit about everything, from looking for a potential site to actually opening your doors, was really good for starting my journey. … I would 100% recommend Bobby’s course.”", "video_url": "https://www.youtube.com/watch?v=NHexpVVcIrY", "fallback": "film-laurie.webp", "fallback_height": 662 } }
  ]}]
}
{% endschema %}
