<section class="store"><div class="container">
  <h1 class="h-section" style="margin-bottom:32px">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="grid-cards">
      {%- for article in blog.articles -%}
        <a class="card" href="{{ article.url }}">
          {%- if article.image -%}{{ article.image | image_url: width: 600 | image_tag: loading: 'lazy' }}{%- endif -%}
          <div class="card__body"><p class="card__title">{{ article.title }}</p><p class="card__price">{{ article.published_at | date: '%-d %B %Y' }}</p></div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
  {%- endpaginate -%}
</div></section>
{% schema %} { "name": "Blog", "settings": [] } {% endschema %}
