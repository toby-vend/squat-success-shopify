{%- comment -%} Product page buy box — from Claude Design "Dental Freedom Blueprint - PDP" {%- endcomment -%}
{%- liquid
  assign media = product.media
  assign front = section.settings.image_front
  assign spine = section.settings.image_spine
  assign spread = section.settings.image_spread
  assign hand = section.settings.image_hand
  if front == blank and media[0] != blank
    assign front = media[0].preview_image
  endif
  if spine == blank and media[1] != blank
    assign spine = media[1].preview_image
  endif
  if spread == blank and media[2] != blank
    assign spread = media[2].preview_image
  endif
  if hand == blank and media[3] != blank
    assign hand = media[3].preview_image
  endif
  assign accent = section.settings.title_accent
  if accent != blank and product.title contains accent
    assign title_main = product.title | remove_last: accent | strip
  else
    assign title_main = product.title
    assign accent = ''
  endif
-%}
<section class="pdp-hero">
  <div class="pdp-wrap pdp-hero__grid">

    <div class="pdp-gallery" data-gallery>
      <div class="pdp-gallery__main">
        <div data-gallery-main>
          {%- if front != blank -%}
            {{ front | image_url: width: 1600 | image_tag: alt: product.title, loading: 'eager', widths: '600, 900, 1200, 1600' }}
          {%- else -%}
            <img src="{{ 'book-cover.jpg' | asset_url }}" alt="{{ product.title | escape }}" width="1696" height="2528" loading="eager">
          {%- endif -%}
        </div>
        <span class="pdp-gallery__badge">{{ section.settings.badge }}</span>
      </div>
      <div class="pdp-gallery__thumbs">
        {%- assign slots = 'spine,spread,hand' | split: ',' -%}
        {%- for slot in slots -%}
          {%- case slot -%}
            {%- when 'spine' -%}{%- assign img = spine -%}{%- assign lbl = section.settings.label_spine -%}
            {%- when 'spread' -%}{%- assign img = spread -%}{%- assign lbl = section.settings.label_spread -%}
            {%- else -%}{%- assign img = hand -%}{%- assign lbl = section.settings.label_hand -%}
          {%- endcase -%}
          {%- if img != blank -%}
            <button type="button" class="pdp-gallery__thumb" data-gallery-thumb aria-label="{{ lbl | escape }}" data-full="{{ img | image_url: width: 1600 }}">
              {{ img | image_url: width: 500 | image_tag: alt: lbl, loading: 'lazy' }}
            </button>
          {%- else -%}
            <div class="pdp-gallery__thumb" aria-hidden="true"><div class="pdp-slot">{{ lbl }}</div></div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="pdp-buy">
      <p class="pdp-label">{{ section.settings.eyebrow }}</p>
      <h1 class="pdp-buy__title">{{ title_main }}{% if accent != blank %} <span class="grad-text">{{ accent }}</span>{% endif %}</h1>
      <p class="pdp-buy__intro">{{ section.settings.intro }}</p>

      <div class="pdp-buy__price">
        <span class="pdp-buy__amount">{{ product.price | money }}</span>
        <span class="pdp-buy__postage">+ {{ settings.postage_price | default: '£4.95' }} UK postage</span>
        <span class="pdp-buy__spacer"></span>
        <span class="pdp-buy__stock">{% if product.available %}{{ section.settings.stock_note }}{% else %}NOT AVAILABLE RIGHT NOW{% endif %}</span>
      </div>

      <div class="pdp-buy__cta" data-sticky-anchor>
        {% render 'order-button', label: section.settings.button_label, style: 'amber', product_override: product, block: true %}
        <p class="pdp-buy__micro">{{ section.settings.micro }}</p>
      </div>

      <p class="pdp-buy__fine">{{ section.settings.fine_print }}</p>

      {%- if section.blocks.size > 0 -%}
      <ul class="pdp-facts">
        {%- for block in section.blocks -%}
          <li class="{% if block.settings.muted %}is-note{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if section.settings.show_sticky -%}
<div class="pdp-sticky" data-sticky-bar aria-hidden="true">
  <div class="pdp-sticky__inner">
    <div class="pdp-sticky__meta">
      <span class="pdp-sticky__title">{{ product.title }}</span>
      <span class="pdp-sticky__price">FREE · {{ settings.postage_price | default: '£4.95' }} POSTAGE</span>
    </div>
    {% render 'order-button', label: section.settings.sticky_label, style: 'amber', product_override: product %}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "PDP — buy box",
  "settings": [
    { "type": "header", "content": "Gallery" },
    { "type": "paragraph", "content": "Product media is used in order: front, spine, spread, in hand. These pickers override it." },
    { "type": "image_picker", "id": "image_front", "label": "Front cover" },
    { "type": "image_picker", "id": "image_spine", "label": "Spine" },
    { "type": "image_picker", "id": "image_spread", "label": "Open spread" },
    { "type": "image_picker", "id": "image_hand", "label": "In hand" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "FREE PAPERBACK" },
    { "type": "text", "id": "label_spine", "label": "Spine placeholder label", "default": "Spine" },
    { "type": "text", "id": "label_spread", "label": "Spread placeholder label", "default": "Open spread" },
    { "type": "text", "id": "label_hand", "label": "In-hand placeholder label", "default": "In hand" },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PAPERBACK · PRINTED TO ORDER IN THE UK" },
    { "type": "text", "id": "title_accent", "label": "Title word to highlight (must appear in the product title)", "default": "Blueprint" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "The system Dr Bobby Bhandal used to build Avenue Dental from an empty unit into a thriving private squat — and has since used to help dentists across the UK do the same. Nine chapters, real numbers, in order." },
    { "type": "text", "id": "stock_note", "label": "Stock note", "default": "IN STOCK · 5–7 WORKING DAYS" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Send me my free copy" },
    { "type": "text", "id": "micro", "label": "Line under button", "default": "ONE-SCREEN CHECKOUT — SHOP PAY, APPLE PAY OR GOOGLE PAY" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "FREE BOOK · YOU COVER £4.95 POSTAGE · NO SUBSCRIPTION, EVER · POSTAGE REFUNDED IF IT ISN'T USEFUL" },
    { "type": "header", "content": "Sticky buy bar" },
    { "type": "checkbox", "id": "show_sticky", "label": "Show sticky bar when the button scrolls out of view", "default": true },
    { "type": "text", "id": "sticky_label", "label": "Sticky bar button", "default": "Send me my copy" }
  ],
  "blocks": [ { "type": "fact", "name": "Fact", "settings": [
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "muted", "label": "Muted note style", "default": false }
  ]}],
  "presets": [{ "name": "PDP — buy box", "blocks": [
    { "type": "fact", "settings": { "text": "Written by the dentist who did it — founder of Avenue Dental, Leamington Spa." } },
    { "type": "fact", "settings": { "text": "UK shipping only for now. Printed to order, despatched from the UK." } },
    { "type": "fact", "settings": { "text": "Order updates by email. Unsubscribe on every one." } },
    { "type": "fact", "settings": { "text": "Keep each address line under 30 characters so the printer accepts it.", "muted": true } }
  ]}]
}
{% endschema %}
