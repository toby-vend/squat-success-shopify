{%- comment -%}
  Standalone claim page (template page.claim → /pages/claim or whatever handle you give the page).
  Same form as the pop-up, rendered inline, so ads and emails can link straight to the lead capture.
{%- endcomment -%}
<section class="store claim-page">
  <div class="container claim-page__grid">
    <div class="claim-page__aside">
      {%- if section.settings.show_cover -%}
        <img class="claim-page__cover" src="{{ 'cover-art.webp' | asset_url }}" alt="{{ settings.book_product.title | default: 'The Dental Freedom Blueprint' | escape }}" width="600" height="902" loading="eager" fetchpriority="high">
      {%- endif -%}
      {%- if section.settings.blurb != blank -%}<p class="body claim-page__blurb">{{ section.settings.blurb }}</p>{%- endif -%}
    </div>
    <div class="claim__dialog claim__dialog--inline">
      {% render 'claim-form', context: 'page', heading_tag: 'h1' %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Claim page",
  "settings": [
    { "type": "checkbox", "id": "show_cover", "label": "Show the book cover", "default": true },
    { "type": "textarea", "id": "blurb", "label": "Blurb beside the form", "default": "Tell us where to send it. You pay the £4.95 postage at the next step — the details you enter here carry straight through so you don't type them twice." }
  ]
}
{% endschema %}
