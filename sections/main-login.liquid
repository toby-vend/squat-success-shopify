<section class="store"><div class="container">
  <h1 class="h-section" style="margin-bottom:24px">{{ 'customer.login' | t }}</h1>
  {%- form 'customer_login', class: 'form' -%}
    {{ form.errors | default_errors }}
    <label for="login-email">{{ 'customer.email' | t }}</label><input type="email" id="login-email" name="customer[email]" autocomplete="email">
    <label for="login-password">{{ 'customer.password' | t }}</label><input type="password" id="login-password" name="customer[password]" autocomplete="current-password">
    <button type="submit" class="btn btn--gold">{{ 'customer.login' | t }}</button>
    <a class="small-print" href="#recover">{{ 'customer.forgot' | t }}</a>
    <a class="small-print" href="{{ routes.account_register_url }}">{{ 'customer.register' | t }}</a>
  {%- endform -%}
  <div id="recover" style="margin-top:40px">
    {%- form 'recover_customer_password', class: 'form' -%}
      {{ form.errors | default_errors }}
      <label for="recover-email">{{ 'customer.email' | t }}</label><input type="email" id="recover-email" name="email">
      <button type="submit" class="btn btn--outline">{{ 'customer.forgot' | t }}</button>
    {%- endform -%}
  </div>
</div></section>
{% schema %} { "name": "Login", "settings": [] } {% endschema %}
