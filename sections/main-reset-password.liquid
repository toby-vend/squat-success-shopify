<section class="store"><div class="container">
  <h1 class="h-section" style="margin-bottom:24px">Reset password</h1>
  {%- form 'reset_customer_password', class: 'form' -%}
    {{ form.errors | default_errors }}
    <input type="password" name="customer[password]" placeholder="{{ 'customer.password' | t }}">
    <input type="password" name="customer[password_confirmation]" placeholder="Confirm password">
    <button type="submit" class="btn btn--gold">Reset</button>
  {%- endform -%}
</div></section>
{% schema %} { "name": "Reset password", "settings": [] } {% endschema %}
