<section class="password">
  <div>
    <div class="footer__logo" style="margin:0 auto 32px">{% render 'logo' %}</div>
    <h1 class="h-section">{{ section.settings.heading }}</h1>
    <p class="body" style="margin:16px 0 32px">{{ section.settings.text }}</p>
    {%- form 'storefront_password', class: 'form', style: 'margin:0 auto' -%}
      {{ form.errors | default_errors }}
      <input type="password" name="password" placeholder="{{ 'customer.password' | t }}" aria-label="Password">
      <button type="submit" class="btn btn--gold">Enter</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Password page", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon." },
  { "type": "text", "id": "text", "label": "Text", "default": "The Dental Freedom Blueprint is on its way." }
]}
{% endschema %}
