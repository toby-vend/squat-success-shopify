<section class="store"><div class="container">
  <h1 class="h-section" style="margin-bottom:8px">Order {{ order.name }}</h1>
  <p class="body">{{ order.created_at | date: '%-d %B %Y' }} · {{ order.fulfillment_status_label }}</p>
  <table class="cart-table">
    <thead><tr><th>Item</th><th>Qty</th><th>Total</th></tr></thead>
    <tbody>{%- for line in order.line_items -%}<tr><td>{{ line.title }}</td><td>{{ line.quantity }}</td><td>{{ line.final_line_price | money }}</td></tr>{%- endfor -%}</tbody>
  </table>
  <p class="body">Subtotal {{ order.subtotal_price | money }} · Shipping {{ order.shipping_price | money }} · <strong>Total {{ order.total_price | money }}</strong></p>
  {%- if order.shipping_address -%}<p class="body" style="margin-top:24px">{{ order.shipping_address | format_address }}</p>{%- endif -%}
</div></section>
{% schema %} { "name": "Order", "settings": [] } {% endschema %}
