<section class="section section--ink author" id="the-author">
  <div class="container">
    <div class="author__grid">
      <figure class="portrait">
        {%- if section.settings.portrait != blank -%}
          {{ section.settings.portrait | image_url: width: 820 | image_tag: loading: 'lazy', widths: '410, 820' }}
        {%- else -%}
          <img src="{{ 'portrait-bobby.jpg' | asset_url }}" alt="{{ section.settings.caption | escape }}" width="410" height="540" loading="lazy">
        {%- endif -%}
        <i aria-hidden="true"></i>
        <figcaption class="portrait__caption">{{ section.settings.caption }}</figcaption>
      </figure>
      <div class="bio">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="bio__title">{{ section.settings.heading }}</h2>
        <p class="bio__hook">{{ section.settings.hook }}</p>
        {%- for block in section.blocks -%}
          {%- if block.type == 'paragraph' -%}<p class="bio__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>{%- endif -%}
        {%- endfor -%}
        {%- if section.settings.strip != blank -%}<p class="bio__strip">{{ section.settings.strip }}</p>{%- endif -%}
      </div>
    </div>
    <div class="arc" data-arc>
      <div class="arc__row">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- unless forloop.first -%}{%- endunless -%}
            <a href="#" class="arc__step {% if block.settings.gold %}arc__step--gold{% endif %}" data-arc-step="{{ block.settings.detail | escape }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            <span class="arc__sep" aria-hidden="true">→</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <p class="arc__detail" data-arc-detail>{{ section.settings.arc_hint }}</p>
    </div>
  </div>
</section>
<style>#shopify-section-{{ section.id }} .arc__row .arc__sep:last-child { display: none; }</style>
{% schema %}
{
  "name": "The author",
  "settings": [
    { "type": "image_picker", "id": "portrait", "label": "Portrait (optional — bundled photo used by default)" },
    { "type": "text", "id": "caption", "label": "Portrait caption", "default": "DR BOBBY BHANDAL · FOUNDER, AVENUE DENTAL" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BE BOLD · THE AUTHOR" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dr Bobby Bhandal nearly got thrown out of dental school." },
    { "type": "text", "id": "hook", "label": "Hook line", "default": "He’ll happily tell you about it." },
    { "type": "textarea", "id": "strip", "label": "Closing strip", "default": "The Dental Freedom Blueprint is everything he’d tell you over a long coffee, written down properly." },
    { "type": "text", "id": "arc_hint", "label": "Career arc hint", "default": "Hover any moment for the detail" }
  ],
  "blocks": [
    { "type": "paragraph", "name": "Paragraph", "settings": [ { "type": "textarea", "id": "text", "label": "Text" } ] },
    { "type": "step", "name": "Career step", "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "text", "id": "detail", "label": "Detail (shown on hover)" },
      { "type": "checkbox", "id": "gold", "label": "Highlight in gold", "default": false }
    ]}
  ],
  "presets": [{ "name": "The author", "blocks": [
    { "type": "paragraph", "settings": { "text": "He worked as an associate for ten years across NHS and private practice, and found the routine so demoralising that he considered leaving dentistry altogether." } },
    { "type": "paragraph", "settings": { "text": "Instead he built the practice he’d wanted to work in and couldn’t find. Avenue Dental opened as a squat — through a builder walking off site, a CQC process he’d rather forget, and a stretch of months where he wasn’t at all sure it would work. It worked." } },
    { "type": "step", "settings": { "label": "Dental school", "detail": "Nearly thrown out. Stayed. Qualified." } },
    { "type": "step", "settings": { "label": "Ten years an associate", "detail": "NHS and private. Capped, restless, done." } },
    { "type": "step", "settings": { "label": "Avenue Dental", "detail": "An empty unit becomes a thriving private squat." } },
    { "type": "step", "settings": { "label": "Dentists across the UK", "detail": "He’s helped dentists across the UK do the same — now written down as a book.", "gold": true } }
  ]}]
}
{% endschema %}
