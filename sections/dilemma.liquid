<section class="section section--ink dilemma">
  <div class="dilemma__glow" aria-hidden="true"><img src="{{ 'amber-glow.svg' | asset_url }}" alt="" width="1693" height="1693" loading="lazy"></div>
  <div class="container dilemma__inner">
    <h2 class="h-display dilemma__title">{{ section.settings.heading | newline_to_br }}</h2>
    <div class="facing">
      {%- for block in section.blocks -%}
        {%- if block.type == 'path' -%}
        {%- if forloop.first -%}{%- assign side = 'verso' -%}{%- else -%}{%- assign side = 'recto' -%}{%- endif -%}
        <article class="facing__page facing__page--{{ side }}" {{ block.shopify_attributes }}>
          <div class="facing__photo">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200' }}
            {%- elsif block.settings.fallback != blank -%}
              <img src="{{ block.settings.fallback | asset_url }}" alt="" width="1184" height="672" loading="lazy">
            {%- endif -%}
          </div>
          <p class="eyebrow {% if forloop.first %}eyebrow--muted{% endif %}">{{ block.settings.eyebrow }}</p>
          <h3 class="h-card">{{ block.settings.heading }}</h3>
          <p class="body">{{ block.settings.text }}</p>
          <p class="facing__pull {% if forloop.first %}facing__pull--muted{% else %}facing__pull--bright{% endif %}">{{ block.settings.pull }}</p>
        </article>
        {%- endif -%}
      {%- endfor -%}
      <div class="facing__gutter" aria-hidden="true"></div>
    </div>
    <div class="punchline">
      <h3 class="punchline__title">{{ section.settings.punch_heading | newline_to_br }}</h3>
      <p class="lede">{{ section.settings.punch_text }}</p>
      <a class="text-cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }} {% render 'icon-arrow' %}</a>
      <span class="punchline__rule"></span>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Two dentists",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Two dentists. Same year,\nsame starting salary." },
    { "type": "textarea", "id": "punch_heading", "label": "Punchline heading", "default": "The difference wasn’t talent, luck,\nor a rich uncle." },
    { "type": "text", "id": "punch_text", "label": "Punchline text", "default": "It was that one of them had a plan, and the other had a feeling." },
    { "type": "text", "id": "cta_label", "label": "Text CTA", "default": "GET THE PLAN — FREE" },
    { "type": "url", "id": "cta_url", "label": "Text CTA link", "default": "/#the-book" }
  ],
  "blocks": [
    { "type": "path", "name": "Path", "limit": 2, "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "fallback", "label": "Bundled fallback asset", "info": "Leave as is unless you know what you're doing" },
      { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "textarea", "id": "pull", "label": "Pull line" }
    ]}
  ],
  "presets": [{ "name": "Two dentists", "blocks": [
    { "type": "path", "settings": { "fallback": "photo-cautious.jpg", "eyebrow": "OPTION A — THE CAUTIOUS PATH", "heading": "She took the safe one and stayed in corporate.", "text": "Ten years on, her diary is built by someone else. Her clinical range has narrowed to whatever the corporate target rewards. She earns a decent, predictable salary — and she owns absolutely nothing. No equity, no asset, no exit.", "pull": "She still says “one day” about having her own place. She’s been saying it for nine years." } },
    { "type": "path", "settings": { "fallback": "photo-brave.jpg", "eyebrow": "OPTION B — THE BRAVE PATH", "heading": "He signed a lease on an empty unit and terrified himself.", "text": "Year one was hard — he’d tell you that himself. But ten years on he has three associates, a team who’ve stayed, a business with a sale value, and a Monday morning he doesn’t dread.", "pull": "Same career. Wildly different life." } }
  ]}]
}
{% endschema %}
