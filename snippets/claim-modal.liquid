{%- comment -%}
  "Claim your copy" lead form pop-up — from Claude Design "Claim Your Copy - Lead Form".
  Rendered once per page by the layouts. Any element with [data-claim-open] opens it.
  The form itself lives in snippets/claim-form.
{%- endcomment -%}
<div class="claim" data-claim hidden>
  <div class="claim__backdrop" data-claim-close></div>
  <div class="claim__dialog" role="dialog" aria-modal="true" aria-labelledby="claim-title-modal">
    <button type="button" class="claim__x" data-claim-close aria-label="Close">
      <svg viewBox="0 0 14 14" width="11" height="11" fill="none" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
    {% render 'claim-form', context: 'modal', heading_tag: 'h2' %}
  </div>
</div>
