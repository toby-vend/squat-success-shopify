{%- comment -%}
  The "Send me my free copy" button.
  If settings.book_product is set, this posts the first available variant straight to checkout.
  Otherwise it links to `fallback_url` (or the product page / #the-book).

  Params: label, style (amber|gold|outline), fallback_url, class
{%- endcomment -%}
{%- assign btn_label = label | default: 'Send me my free copy' -%}
{%- assign btn_style = style | default: 'amber' -%}
{%- assign book = settings.book_product -%}
{%- if book != blank and book.available -%}
  {%- form 'product', book, class: 'btn-form' -%}
    <input type="hidden" name="id" value="{{ book.selected_or_first_available_variant.id }}">
    <input type="hidden" name="quantity" value="1">
    <input type="hidden" name="return_to" value="/checkout">
    <button type="submit" class="btn btn--{{ btn_style }} {{ class }}">
      {{ btn_label }}
      {%- render 'icon-arrow' -%}
    </button>
  {%- endform -%}
{%- else -%}
  {%- assign href = fallback_url | default: book.url | default: '#the-book' -%}
  <a class="btn btn--{{ btn_style }} {{ class }}" href="{{ href }}">
    {{ btn_label }}
    {%- render 'icon-arrow' -%}
  </a>
{%- endif -%}
