{%- comment -%}
  The tilted paperback with FREE seal — Figma component "book-stage" (460 × 560).
  Params: cover (image_picker, optional), postage (text), priority ('high' for the hero LCP image), class
{%- endcomment -%}
<div class="book-stage {{ class }}" aria-hidden="true">
  <div class="book-stage__shadow"></div>
  <div class="book-stage__page"></div>
  <div class="book-stage__page book-stage__page--2"></div>
  <div class="book-stage__page book-stage__page--3"></div>
  <div class="book-stage__cover">
    {%- if cover != blank -%}
      {{ cover | image_url: width: 600 | image_tag: alt: '', loading: 'eager', widths: '300, 600', sizes: '300px' }}
    {%- else -%}
      <img src="{{ 'cover-art.webp' | asset_url }}" alt="" width="600" height="902" decoding="async" {% if priority == 'high' %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
    {%- endif -%}
  </div>
  <div class="book-stage__seal">
    <b>FREE</b>
    <small>PAPERBACK</small>
    <em>you cover {{ postage | default: settings.postage_price | default: '£4.95' }} P&amp;P</em>
  </div>
</div>
